---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publications from '../components/Publications.astro';
import { formatYm } from '../lib/dates';
import { site } from '../data/site';

const entries = (await getCollection('cv')).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);
const sections = [
  { key: 'education', title: 'Education' },
  { key: 'experience', title: 'Research and work' },
  { key: 'honors', title: 'Honors' }
] as const;

const period = (start: string, end?: string) =>
  end ? `${formatYm(start)} to ${formatYm(end)}` : formatYm(start);
---

<Base
  title="CV"
  description="CV of Maurice Heide: MSc Data Science at ETH Zurich, BSc Computer Science at TU Dresden, research at Harvard Medical School and MGH and the EKFZ for Digital Health."
>
  <header class="page row head">
    <h1 class="content">CV</h1>
    <p class="content no-print">
      <a class="download" href={site.cv} download>
        Download the PDF
      </a>
      <span class="muted">One page, updated October 2026.</span>
    </p>
  </header>

  {sections.map((s) => (
    <section class="page row section" aria-labelledby={`cv-${s.key}`}>
      <h2 id={`cv-${s.key}`} class="label section-name">
        {s.title}
      </h2>
      <ol class="content entries">
        {entries
          .filter((e) => e.data.section === s.key)
          .map(({ data }) => (
            <li>
              <p class="when mono muted">{period(data.start, data.end)}</p>
              <div>
                <h3>{data.title}</h3>
                <p class="org">
                  {data.org}
                  {data.place && <span class="muted">, {data.place}</span>}
                </p>
                {data.note && <p class="note">{data.note}</p>}
              </div>
            </li>
          ))}
      </ol>
    </section>
  ))}

  <section class="page row section" aria-labelledby="cv-pubs">
    <h2 id="cv-pubs" class="label section-name">
      Publication
    </h2>
    <div class="content">
      <Publications />
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: var(--space-5) var(--space-4);
    row-gap: var(--space-2);
  }

  h1 {
    font-size: var(--text-xl);
  }

  .head p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    font-size: var(--text-sm);
  }

  .download {
    font-weight: 600;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }

  .entries li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (max-width: 40rem) {
    .entries li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  .when {
    margin: 0;
    padding-top: 0.15rem;
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 650;
    margin-bottom: 0.1rem;
  }

  .org {
    margin: 0;
  }

  .note {
    margin: 0.35rem 0 0;
    max-width: var(--measure);
  }

  @media print {
    .head {
      padding-block: 0 8pt;
    }
  }
</style>
