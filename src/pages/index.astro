---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import NewsList from '../components/NewsList.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<Base>
  <section class="page row intro" aria-labelledby="name">
    <div class="head">
      <h1 id="name" class="name">
        Maurice Heide
      </h1>
      <p class="lede">Machine learning and statistics, from research to production.</p>
    </div>
    <figure class="portrait">
      <Image
        src={portrait}
        alt="Portrait of Maurice Heide"
        widths={[320, 560, 840]}
        sizes="(min-width: 48rem) 18rem, 14rem"
        loading="eager"
      />
    </figure>
    <dl class="facts">
      <div>
        <dt>Now</dt>
        <dd>MSc Data Science, ETH Zurich</dd>
      </div>
      <div>
        <dt>Before</dt>
        <dd>Harvard Medical School and MGH, EKFZ for Digital Health, EY</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="page row section about" aria-labelledby="about-title">
    <h2 id="about-title" class="label section-name">
      About
    </h2>
    <div class="content measure">
      <p>
        I am an MSc student in Data Science at ETH Zurich and a scholar of the German Academic
        Scholarship Foundation.
      </p>
      <p>
        For my Bachelor thesis at Harvard Medical School and Massachusetts General Hospital, I
        benchmarked six published CT foundation models on 11 cohorts and distilled the two strongest
        into 14 compact 3D models. Before that, I was shared first author of MuCoDi at the EKFZ for
        Digital Health in Dresden. The paper received the Best Paper Award at the MICCAI 2026
        Workshop on Efficient Medical AI. At EY in Paris, I built a detector for AI-generated
        document forgeries for EY's forensic document-analysis platform.
      </p>
      <p>
        I graduated first in my cohort from TU Dresden with a BSc in Computer Science, grade 1.0,
        and spent exchange semesters at Seoul National University and NTU Singapore.
      </p>
      <p class="looking">
        I am looking for internships in quantitative research and machine learning.
      </p>
    </div>
  </section>

  <section class="page section" id="work" aria-labelledby="work-title">
    <div class="row">
      <h2 id="work-title" class="label section-name">
        Selected work
        <br />
        <a href="/work/">All work and publications</a>
      </h2>
    </div>
    <ol class="work">
      {projects.map((p, i) => (
        <ProjectRow project={p} index={i + 1} />
      ))}
    </ol>
  </section>

  <section class="page row section" aria-labelledby="news-title">
    <h2 id="news-title" class="label section-name">
      News
      <br />
      <a href="/news/">All news</a>
    </h2>
    <div class="content">
      <NewsList items={news} />
    </div>
  </section>

  <section class="page row section" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="label section-name">
      Contact
    </h2>
    <div class="content">
      <p class="measure">
        Write to me at <a href={`mailto:${site.email}`}>{site.email}</a>. My CV is available{' '}
        <a href={site.cv}>as a PDF</a>.
      </p>
      <ul class="links">
        {site.profiles.map((p) => (
          <li>
            <a href={p.href}>{p.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: var(--space-5) var(--space-4);
    row-gap: var(--space-3);
    border-bottom: 1px solid var(--rule-strong);
  }

  .head {
    grid-column: 1 / span 8;
    grid-row: 1;
  }

  .name {
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-left: -0.03em;
  }

  .portrait {
    grid-column: 10 / span 3;
    grid-row: 1 / span 2;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lede {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .facts {
    grid-column: 1 / span 9;
    grid-row: 2;
    align-self: end;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--gutter);
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  dt {
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 47.99rem) {
    .intro {
      padding-top: var(--space-4);
    }

    .head,
    .facts {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .portrait {
      grid-column: 1 / -1;
      grid-row: auto;
      width: min(60%, 14rem);
      order: -1;
    }

    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .looking {
    padding-left: var(--space-2);
    border-left: 2px solid var(--accent);
  }

  .work {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
