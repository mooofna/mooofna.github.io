---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="page bar">
    <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <button class="theme" type="button" data-theme-toggle>
            Dark
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const effective = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  const sync = () => {
    if (!button) return;
    const next = effective() === 'dark' ? 'light' : 'dark';
    button.textContent = next === 'dark' ? 'Dark' : 'Light';
    button.setAttribute('aria-label', `Switch to the ${next} theme`);
  };

  sync();
  media.addEventListener('change', sync);
  button?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode or blocked storage: the choice lasts for this page only.
    }
    sync();
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 3.75rem;
  }

  .name {
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.6rem + 1.4vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .theme {
    position: relative;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--text);
    text-decoration: none;
    padding-block: 0.35rem;
  }

  nav a[aria-current='page']::after,
  nav a:hover::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }

  .theme {
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    padding-inline: 0;
  }

  .theme:hover {
    color: var(--text);
  }

  /* Very small phones: keep the bar on one line. */
  @media (max-width: 23rem) {
    .name {
      font-size: var(--text-sm);
    }

    ul {
      gap: 0.8rem;
    }
  }
</style>
