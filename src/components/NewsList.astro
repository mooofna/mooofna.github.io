---
import type { CollectionEntry } from 'astro:content';
import { formatMonth } from '../lib/dates';

interface Props {
  items: CollectionEntry<'news'>[];
}

const { items } = Astro.props;
---

<ol class="news">
  {items.map(({ data }) => (
    <li>
      <time class="mono muted" datetime={data.date.toISOString().slice(0, 10)}>
        {formatMonth(data.date)}
      </time>
      <p>
        {data.text}
        {data.link && (
          <>
            {' '}
            <a href={data.link.href}>{data.link.label}</a>
          </>
        )}
      </p>
    </li>
  ))}
</ol>

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  time {
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  p {
    margin: 0;
    max-width: var(--measure);
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
