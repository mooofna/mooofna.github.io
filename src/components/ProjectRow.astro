---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  full?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { project, index, full = false, headingLevel = 'h3' } = Astro.props;
const { title, kind, context, award, summary, image, imageAlt, imageCredit, plate, links, live } =
  project.data;
const { Content } = await render(project);
const Heading = headingLevel;
---

<li class="row item" id={project.id}>
  <p class="label idx">
    <span class="mono num">{String(index).padStart(2, '0')}</span>
    <span class="kind">{kind}</span>
  </p>
  <div class:list={['content', 'body', { full }]}>
    <div class="text">
      <Heading class="title">{title}</Heading>
      {full ? <Content /> : <p class="summary">{summary}</p>}
      {live && (
        <p class="live mono" data-live={live} hidden>
          <span class="dot" aria-hidden="true" />
          <span class="visually-hidden">Live data: </span>
          <span data-live-text />
        </p>
      )}
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="side">
      <p class="meta">
        {award && <span class="award">{award}</span>}
        <span class="muted">{context}</span>
      </p>
      {image && (
        <div>
          <figure class:list={['figure', { plate }]}>
            <Image
              src={image}
              alt={imageAlt ?? ''}
              widths={[480, 800, 1200]}
              sizes="(min-width: 48rem) 26rem, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          {imageCredit && <p class="credit">{imageCredit}</p>}
        </div>
      )}
    </div>
  </div>
</li>

{live && <script src="../scripts/live.ts"></script>}

<style>
  .item {
    padding-block: var(--space-3) var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .item:last-child {
    padding-bottom: 0;
  }

  .idx {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .num {
    font-weight: 500;
    color: var(--accent);
  }

  .kind {
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .idx {
      flex-direction: row;
      gap: 0.75rem;
    }
  }

  /* Inside the content column: text on the left, meta and figure on the right. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: var(--space-2) var(--gutter);
    align-items: start;
  }

  @media (max-width: 47.99rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .title {
    font-size: var(--text-lg);
    margin-bottom: 0.6rem;
  }

  .text :global(p) {
    max-width: var(--measure);
  }

  .summary,
  .full .text :global(p) {
    margin-bottom: var(--space-2);
  }

  .live[hidden] {
    display: none;
  }

  .live {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 var(--space-2);
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .side {
    display: grid;
    gap: var(--space-2);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .award {
    color: var(--accent);
    font-weight: 600;
  }

  .figure {
    margin: 0;
    border: 1px solid var(--rule);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--plate);
  }

  .figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .figure.plate {
    padding: 0.6rem;
  }

  .figure.plate :global(img) {
    object-fit: contain;
  }

  .credit {
    margin: 0.4rem 0 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
