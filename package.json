{
  "name": "mooofna.github.io",
  "private": true,
  "type": "module",
  "description": "Personal homepage of Maurice Heide",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "cv": "cd cv && latexmk -xelatex -interaction=nonstopmode -halt-on-error Maurice_Heide_CV.tex && cp Maurice_Heide_CV.pdf ../public/cv/Maurice_Heide_CV.pdf && latexmk -c",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
